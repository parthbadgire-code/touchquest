# ==============================================================================
# TouchQuest Environment Configuration
# Hacktoberfest Open-Source AI Challenge: Touch Grass
# ==============================================================================

# SUPABASE (Client & Server)
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-never-expose-to-browser

# HOSTED OPEN-WEIGHT INFERENCE (Server-side only)
# OPTION A (RECOMMENDED FREE TIER): Groq Cloud (100% free, no credit card required, instant key at https://console.groq.com/keys)
# Powers ultra-fast open-weight models: Llama-3.1-8b-instant (missions) and Llama-3.2-11b-vision-preview (nature scanner)
GROQ_API_KEY=gsk_your_groq_api_key_here
# Optional Groq model overrides:
# GROQ_MISSION_MODEL=llama-3.1-8b-instant
# GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# OPTION B: Hugging Face Router v1 (Requires pre-paid credits for third-party inference providers)
HF_API_TOKEN=hf_your_huggingface_user_access_token_here
HF_MISSION_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# 3. Audio (BirdCall AI): Dedicated Bioacoustic Serving
# Serverless router providers do not support audio-classification.
# Provide a dedicated container or Hugging Face Space URL here to enable live bird song classification:
HF_AUDIO_ENDPOINT=https://your-dedicated-birdnet-space.hf.space/api/predict
HF_AUDIO_MODEL=Cornell-BirdNET

# APPLICATION
NEXT_PUBLIC_APP_URL=http://localhost:3000
